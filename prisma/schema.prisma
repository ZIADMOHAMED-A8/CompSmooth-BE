generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String
  role          Role            @default(USER)
  password      String
  refresh_token String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  payments      Payments[]
  subscriptions Subscriptions[]
  usageLogs     Usage_logs[]

  @@index([email], map: "email_index")
}

model Plans {
  id                    String          @id @default(uuid())
  plan                  plansEnum
  price                 String
  monthly_request_limit Int
  subscriptions         Subscriptions[]
}

model Payments {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  status    String
  createdAt DateTime @default(now())
  user      Users    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Usage_logs {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  user      Users    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Properties {
  id            String   @id @default(uuid())
  address       String
  city          String
  state         String
  zip           String
  latitude      Decimal
  longitude     Decimal
  beds          Int
  baths         Decimal
  sqft          Int
  year_bulit    Int
  property_type String
  createdAt     DateTime @default(now())
}

model Subscriptions {
  id             String     @id @default(uuid())
  userId         String
  planId         String
  createdAt      DateTime   @default(now())
  expirationDate DateTime?
  startDate      DateTime
  status         subsStatus @default(ACTIVE)
  updatedAt      DateTime   @updatedAt
  plan           Plans      @relation(fields: [planId], references: [id])
  user           Users      @relation(fields: [userId], references: [id])

  @@index([planId])
  @@index([userId, status, expirationDate])
}

enum Role {
  USER
  ADMIN
}

enum plansEnum {
  FREE
  PRO
  SUPER
}

enum subsStatus {
  ACTIVE
  EXPIRED
  REFUNDED
}
